# --- Core ---
LL_ENV=production
LL_SECRET_KEY=generate-a-long-random-string-at-least-32-characters
LL_PUBLIC_BASE_URL=https://api.ledgerlight.co.uk
# The 9 websites allowed to call the in-house API (comma-separated, exact origins)
LL_ALLOWED_ORIGINS=https://ledgerlight.co.uk,https://sitesentinel.co.uk,https://sponsorwatch.co.uk,https://estatesignal.co.uk,https://distressradar.co.uk,https://tenantguard.co.uk,https://talentrelease.co.uk,https://creditpulse.co.uk,https://filingpulse.co.uk
# Staff access is granted on the server with: python -m scripts.make_staff EMAIL
# Set true only when running behind your own reverse proxy (it then trusts the address the proxy appends)
LL_TRUST_PROXY=false
# Leave on until email/Slack/SMS settings are tested; messages go to ./outbox instead
LL_DRY_RUN_DELIVERY=true
LL_PROBATE_COOLING_OFF_DAYS=14

# --- Data sources ---
# Free keys: https://developer.company-information.service.gov.uk/
COMPANIES_HOUSE_API_KEY=
COMPANIES_HOUSE_STREAM_KEY=
CH_RATE_LIMIT=550
# HM Land Registry CCOD file (free account needed) - path to the downloaded CSV
HMLR_CCOD_PATH=
# Licensed county court judgment feed (e.g. Registry Trust) - commercial licence needed
CCJ_PROVIDER_URL=
CCJ_PROVIDER_KEY=

# --- AI briefs (optional; template briefs are used without it) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# --- Email (SMTP, e.g. Postmark / SES / SendGrid) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=alerts@ledgerlight.co.uk

# --- SMS (Twilio, Pro plan) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# --- Stripe billing ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_SOLO_MONTHLY=
STRIPE_PRICE_SOLO_ANNUAL=
STRIPE_PRICE_TEAM_MONTHLY=
STRIPE_PRICE_TEAM_ANNUAL=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_ANNUAL=

LL_EXPORT_DIR=./exports

# --- Outreach (selling our own products; console at /outreach) ---
# Shown in every outreach email's footer: the law requires sender identity and a postal address
OUTREACH_COMPANY_NAME=Ledgerlight Ltd
OUTREACH_POSTAL_ADDRESS=
# One line per sending mailbox: the NAME you entered in the console, set to that mailbox's app password
# OUTREACH_PW_SAM=xxxx xxxx xxxx xxxx
